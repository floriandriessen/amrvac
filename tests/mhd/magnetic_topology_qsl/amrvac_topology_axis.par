&magnetic_topology_list
  mt_enable = .true.
  mt_mode = 'axis_plane_full_vtu'
  mt_output_file = 'reg_namelist_qsl_xy_full.vtu'
  mt_dL = 0.05d0
  mt_max_steps = 100
  mt_b_min = 1.d-12
  mt_plane = 'xy'
  mt_xmin = -0.5d0
  mt_xmax = -0.3d0
  mt_nx = 5
  mt_ymin = -0.95d0
  mt_ymax = -0.85d0
  mt_ny = 5
  mt_z0 = 0.d0
/

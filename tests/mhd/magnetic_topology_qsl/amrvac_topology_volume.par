&magnetic_topology_list
  mt_enable = .true.
  mt_mode = 'volume_vti'
  mt_output_file = 'reg_namelist_volume.vti'
  mt_dL = 0.05d0
  mt_max_steps = 100
  mt_b_min = 1.d-12
  mt_xmin = -0.85d0
  mt_xmax = -0.75d0
  mt_nx = 4
  mt_ymin = -0.95d0
  mt_ymax = -0.85d0
  mt_ny = 3
  mt_zmin = -0.5d0
  mt_zmax = 0.5d0
  mt_nz = 2
  mt_compute_twist = .true.
  mt_compute_qperp = .true.
  mt_chunk_nz = 1
/

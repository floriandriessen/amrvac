&magnetic_topology_list
  mt_enable = .true.
  mt_mode = 'axis_plane_csv'
  mt_output_prefix = 'reg_axis_csv_all'
  mt_dL = 0.05d0
  mt_max_steps = 100
  mt_b_min = 1.d-12
  mt_plane = 'xy'
  mt_xmin = -0.5d0
  mt_xmax = -0.3d0
  mt_nx = 5
  mt_ymin = -0.95d0
  mt_ymax = -0.85d0
  mt_ny = 5
  mt_z0 = 0.d0
  mt_compute_twist = .true.
  mt_compute_qperp = .true.
/

! Generate the 3D build files with:
!   $AMRVAC_DIR/setup.pl -d=3 -v=3

&filelist
  base_filename='topology_qsl_regression'
  saveprim=.true.
/

&savelist
  itsave(1,1)=0
  itsave(1,2)=0
/

&stoplist
  it_max=0
  time_max=1.d0
/

&methodlist
  time_stepper='onestep'
  flux_scheme=20*'tvdlf'
  limiter=20*'minmod'
/

&boundlist
  typeboundary_min1=8*'cont'
  typeboundary_max1=8*'cont'
  typeboundary_min2=8*'cont'
  typeboundary_max2=8*'cont'
  typeboundary_min3=8*'cont'
  typeboundary_max3=8*'cont'
/

&meshlist
  refine_max_level=1
  block_nx1=8
  block_nx2=8
  block_nx3=8
  domain_nx1=16
  domain_nx2=16
  domain_nx3=16
  xprobmin1=-1.d0
  xprobmax1=1.d0
  xprobmin2=-1.d0
  xprobmax2=1.d0
  xprobmin3=-1.d0
  xprobmax3=1.d0
/

&paramlist
  courantpar=0.5d0
/

&mhd_list
  mhd_energy=.true.
  typedivbfix='none'
/

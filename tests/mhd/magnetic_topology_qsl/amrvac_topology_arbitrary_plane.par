&magnetic_topology_list
  mt_enable = .true.
  mt_mode = 'arbitrary_plane_products'
  mt_output_prefix = 'reg_namelist_arb'
  mt_dL = 0.05d0
  mt_max_steps = 100
  mt_b_min = 1.d-12
  mt_compute_twist = .true.
  mt_compute_qperp = .true.
  mt_write_csv = .false.
  mt_origin = -0.4d0, -0.9d0, 0.d0
  mt_e1 = 1.d0, 0.d0, 0.d0
  mt_e2 = 0.d0, 1.d0, 0.d0
  mt_s1min = -0.1d0
  mt_s1max =  0.1d0
  mt_n1 = 5
  mt_s2min = -0.05d0
  mt_s2max =  0.05d0
  mt_n2 = 5
/

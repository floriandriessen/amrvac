! Native spherical thick AIA 171 image from a cube-corner LOS.
! In the emissionlist, LOS_theta/LOS_phi denote the observer direction.
! Internally rays march along -spherical_to_cartesian(LOS_theta, LOS_phi),
! so these angles place the observer on the (+,+,+) side of the local patch.

&filelist
  convert=.true.
  autoconvert=.false.
  convert_type='EIvtiCCmpi'
  restart_from_file='output/radsyn_sph_prom_0000.dat'
/

&savelist
  itsave(1,1)=0
  itsave(1,2)=0
/

&stoplist
  it_max=0
  time_max=1.d0
/

&methodlist
  time_stepper='onestep'
  flux_scheme=20*'tvdlf'
  limiter=20*'minmod'
/

&boundlist
  typeboundary_min1=8*'cont'
  typeboundary_max1=8*'cont'
  typeboundary_min2=8*'cont'
  typeboundary_max2=8*'cont'
  typeboundary_min3=8*'cont'
  typeboundary_max3=8*'cont'
/

&meshlist
  refine_max_level=1
  block_nx1=32
  block_nx2=32
  block_nx3=32
  domain_nx1=256
  domain_nx2=192
  domain_nx3=256
  xprobmin1=69.61d0
  xprobmax1=79.61d0
  xprobmin2=0.2270568141714314d0
  xprobmax2=0.2729431858285686d0
  xprobmin3=-0.01718120494117723d0
  xprobmax3= 0.01718120494117723d0
/

&paramlist
  courantpar=0.5d0
/

&mhd_list
  mhd_energy=.true.
  typedivbfix='none'
  B0field=.false.
/

&emissionlist
  filename_euv='output/AIA171_sph_native_corner45_top_thick_'
  wavelength=171
  LOS_theta=54.735610317245346d0
  LOS_phi=45.d0
  dat_resolution=.false.
  radiation_transfer='thick'
  ray_method='sph_intersection'
  emission_model='euv_aia'
  output_tau=.true.
  output_absorption_fraction=.true.
/

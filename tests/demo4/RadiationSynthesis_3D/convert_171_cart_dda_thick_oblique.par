! Oblique optically thick AIA 171 dat-resolution image using segment-sorted Cartesian native rays.

&filelist
  convert=.true.
  autoconvert=.false.
  convert_type='EIvtiCCmpi'
  restart_from_file='output/radsyn_tdm_prom_amr_0000.dat'
/

&savelist
  itsave(1,1)=0
  itsave(1,2)=0
/

&stoplist
  it_max=0
  time_max=1.d0
/

&methodlist
  time_stepper='onestep'
  flux_scheme=20*'tvdlf'
  limiter=20*'minmod'
/

&boundlist
  typeboundary_min1=8*'cont'
  typeboundary_max1=8*'cont'
  typeboundary_min2=8*'cont'
  typeboundary_max2=8*'cont'
  typeboundary_min3=8*'cont'
  typeboundary_max3=8*'cont'
/

&meshlist
  refine_max_level=2
  block_nx1=16
  block_nx2=16
  block_nx3=16
  domain_nx1=32
  domain_nx2=32
  domain_nx3=32
  xprobmin1=-4.d0
  xprobmax1= 4.d0
  xprobmin2=-4.d0
  xprobmax2= 4.d0
  xprobmin3= 0.d0
  xprobmax3= 6.d0
/

&paramlist
  courantpar=0.5d0
/

&mhd_list
  mhd_energy=.true.
  typedivbfix='none'
  B0field=.false.
/

&emissionlist
  filename_euv='output/AIA171_cart_dda_thick_oblique_'
  wavelength=171
  LOS_theta=60.d0
  LOS_phi=30.d0
  dat_resolution=.true.
  radiation_transfer='thick'
  ray_method='cart'
  emission_model='euv_aia'
  output_tau=.true.
  output_absorption_fraction=.true.
/

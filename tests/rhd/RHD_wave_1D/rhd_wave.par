&testlist
        teststr=''
/

&filelist
  base_filename='rhd_wave'
  autoconvert      = F
  typefilelog='regression_test'
  saveprim         = T
  nwauxio = 0
/

 &savelist
   dtsave_log     = 5.d-4
/

 &stoplist
   time_max = 1.d-2
   dtmin = 2.0d-20
/

 &methodlist
   time_stepper = 'onestep'
   time_integrator = 'IMEX_SP'
   flux_scheme     = 20*'hll'
   limiter         = 20*'weno5'
/

&boundlist
  typeboundary_min1 = 4*'cont'
  typeboundary_max1 = 4*'cont'
  internalboundary=T
/

 &meshlist
   refine_max_level   = 1
   domain_nx1         = 2000
   block_nx1          = 500
   xprobmin1       = 0.d0
   xprobmax1       = 20.d0
 /

 &paramlist
  courantpar       = 0.2d0
 /

 &hd_list
  He_abundance = 0.0d0
  hd_energy = .true.
  hd_gamma = 1.6666667d0
  hd_radiation_fld = .true.
 /

 &fld_list
  fld_Radforce_split = .false.
  fld_opacity_law = 'const'
  fld_kappa0 = 0.4d0
  fld_interaction_method = 'Halley'
  fld_fluxlimiter = 'Diffusion'
  fld_diff_tol = 1.d-7
  /

 &wave_list
  rho0 = 3.216d-9
  eg0 = 26.020d3
  Er0 = 17.340d3
  tau_wave = 1.d3
  ampl = 1.d-2
  /

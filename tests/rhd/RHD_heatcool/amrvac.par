&testlist
        teststr=''
/

&filelist
  base_filename='test'
  autoconvert      = T
  convert_type     = 'vtuBCCmpi'
  saveprim         = F
/

 &savelist
   itsave(1,1)     = 0
   itsave(1,2)     = 0
/

 &stoplist
   dtmin = 1.0d-20
   it_max = 10000
/

 &methodlist
   time_stepper = 'onestep'
   time_integrator = 'IMEX_SP'
   flux_scheme     = 20*'hll'
   limiter         = 20*'koren'
/

&boundlist
  nghostcells  =  2
  typeboundary_min1 = 5*'periodic'
  typeboundary_max1 = 5*'periodic'
  typeboundary_min2 = 5*'periodic'
  typeboundary_max2 = 5*'periodic'
/

 &meshlist
   refine_max_level   = 1
   domain_nx1         = 4
   domain_nx2         = 4
   block_nx1          = 4
   block_nx2          = 4
   xprobmin1       =  -0.5d0
   xprobmax1       =  0.5d0
   xprobmin2       =  0.0d0
   xprobmax2       =  1.0d0
 /

 &paramlist
  dtpar = 1.d-9
 /

 &hd_list
  hd_energy = .true.
  hd_gamma = 1.666667d0
  hd_radiation_fld_formalism = 'fld'
  hd_radiation_fld = .true.
 /

 &fld_list
  fld_Eint_split = .false.
  fld_Radforce_split = .false
  fld_opacity_law = 'const'
  fld_kappa0 = 0.4d0
  fld_interaction_method = 'Halley'
 /

 &test_list
  rho0 = 1.d-7
  t0 = 1.d-2
  E_r0 = 1.d12
 /

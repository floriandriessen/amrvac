&testlist
        teststr=''
/

&filelist
  base_filename='rhd_shock'
  saveprim         = F
  autoconvert      = F
  typefilelog='regression_test'
/

 &savelist
   itsave(1,1)=0
   itsave(1,2)=0
   dtsave_log     = 1.0d0
   dtsave_dat     = 10.d0
/

 &stoplist
   time_max = 10.d0
   dtmin = 1.0d-20
/

 &methodlist
   time_stepper = 'onestep'
   time_integrator = 'IMEX_SP'
   flux_scheme     = 20*'hll'
   limiter         = 20*'minmod'
/

&boundlist
  typeboundary_min1 = 4*'special'
  typeboundary_max1 = 4*'cont' 
/

 &meshlist
   refine_max_level   = 1
   domain_nx1         = 256
   block_nx1          = 16
   xprobmin1       = -0.5d0
   xprobmax1       = 0.5d0
 /

 &paramlist
  courantpar       = 0.6d0
  slowsteps = 200
 /

 &hd_list
  He_abundance = 0.d0
  hd_gravity = .false.
  hd_energy = .true.
  hd_gamma = 1.4d0
  hd_radiation_fld = .true.
 /

 &fld_list
  fld_Radforce_split = .false.
  fld_opacity_law = 'const'
  fld_kappa0 = 0.4d0
  fld_interaction_method = 'Halley'
  fld_fluxlimiter = 'Diffusion'
  fld_diff_tol = 1.d-7
  /

  &shock_list
   rho1 = 1.d-2
   rho2 = 0.0685847d0 
   v1 = 1.d9
   v2 = 1.458051139d8
   T1 = 1.d4
   T2 = 4.239d7
   /

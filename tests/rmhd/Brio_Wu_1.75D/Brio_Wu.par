 &filelist
        base_filename='output/Brio_Wu_kappa4_'
        autoconvert=F
        saveprim=F
        typefilelog='regression_test'
        nwauxio=2
 /

 &savelist
        itsave(1,1)=0
        itsave(1,2)=0
        ditsave_log=100
      ditsave_dat=1000
 /

 &stoplist
        dtmin=1.d-20
        time_max=0.2d0 
        it_max=100000
 /

 &methodlist
        time_stepper=  'threestep'
        time_integrator= 'IMEX_ARS3'
        flux_scheme=    20*'hll'
        limiter= 20*'weno3'
 /
        time_stepper=  'onestep'
        time_integrator= 'IMEX_SP'
        flux_scheme=    20*'hll'
        limiter= 20*'koren'

 &boundlist
        typeboundary_min1=9*'special' 
        typeboundary_max1=9*'special' 
 /
        typeboundary_min1=9*'cont' 
        typeboundary_max1=9*'cont' 

 &meshlist
        refine_max_level=4
        w_refine_weight(1)=0.5
        w_refine_weight(3)=0.5
        refine_threshold=20*0.05d0
        domain_nx1=1024
        block_nx1=16
        xprobmin1=-1.d0
        xprobmax1= 1.d0
 /

 &paramlist
        courantpar=0.4d0
        slowsteps=20000
 /

 &mhd_list
     typedivbfix='none'
     He_abundance = 0.0d0 
     mhd_energy = .true.
     mhd_radiation_fld = .true.
     mhd_gamma=2.0d0
 /

     fld_kappa0 = 4.0d2
 &fld_list
     fld_Radforce_split = .false.
     fld_opacity_law = 'const'
     fld_kappa0 = 0.4d0
     fld_interaction_method = 'Halley'
     fld_fluxlimiter = 'Diffusion'
     fld_diff_tol = 1.d-6
     fld_force_MG_converged=T
     fld_slowsteps=T
     fld_boost_dt=1.0d4
 /
     fld_debug=T
     fld_no_mg=T
     fld_fluxlimiter = 'Pomraning'

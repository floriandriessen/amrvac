 &filelist
        base_filename='output/Brio_Wu'
        autoconvert=F
        saveprim=F
        typefilelog='regression_test'
        nwauxio=2
 /

 &savelist
        itsave(1,1)=0
        itsave(1,2)=0
        ditsave_log=100
        dtsave_dat=0.01d0
 /
        ditsave_dat=1

        it_max=100
 &stoplist
        time_max=0.2d0 
 /

        time_stepper=  'threestep'
        time_integrator= 'IMEX_ARS3'
        flux_scheme=    20*'hll'
        limiter= 20*'weno3'
 &methodlist
        time_stepper=  'onestep'
        time_integrator= 'IMEX_SP'
        flux_scheme=    20*'hll'
        limiter= 20*'koren'
 /

        typeboundary_min1=9*'cont' 
        typeboundary_max1=9*'cont' 
 &boundlist
        typeboundary_min1=9*'special' 
        typeboundary_max1=9*'special' 
 /

 &meshlist
        refine_max_level=5
        w_refine_weight(1)=0.5
        w_refine_weight(3)=0.5
        refine_threshold=20*0.05d0
        domain_nx1=1024
        block_nx1=16
        xprobmin1=-1.d0
        xprobmax1= 1.d0
 /

 &paramlist
        courantpar=0.4d0
        slowsteps=20000
 /

 &mhd_list
     typedivbfix='none'
     He_abundance = 0.0d0 
     mhd_energy = .true.
     mhd_radiation_fld = .true.
     mhd_gamma=2.0d0
 /

 &fld_list
     fld_Radforce_split = .false.
     fld_opacity_law = 'const'
     fld_kappa0 = 4.0d5
     fld_interaction_method = 'Halley'
     fld_fluxlimiter = 'Diffusion'
     fld_diff_tol = 1.d-3
     fld_force_MG_converged=T
 /
     fld_debug=T
     fld_no_mg=T
     fld_fluxlimiter = 'Pomraning'

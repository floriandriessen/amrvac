! Benchmark uniform 128^3: central yz minimal plane, 128x128 seeds.
&filelist
  convert=.true.
  convert_type='user'
  autoconvert=.false.
  restart_from_file='output/qsl_tdm_direct_u128_snap0000.dat'
/

&savelist
  itsave(1,1)=0
  itsave(1,2)=0
/

&stoplist
  it_max=0
  time_max=1.d0
/

&methodlist
  time_stepper='onestep'
  flux_scheme=20*'tvdlf'
  limiter=20*'minmod'
/

&boundlist
  typeboundary_min1=8*'cont'
  typeboundary_max1=8*'cont'
  typeboundary_min2=8*'cont'
  typeboundary_max2=8*'cont'
  typeboundary_min3=8*'cont'
  typeboundary_max3=8*'cont'
/

&paramlist
  courantpar=0.5d0
/

&mhd_list
  mhd_energy=.true.
  typedivbfix='none'
  B0field=.false.
/

&meshlist
  refine_max_level=1
  block_nx1=32
  block_nx2=32
  block_nx3=32
  domain_nx1=128
  domain_nx2=128
  domain_nx3=128
  xprobmin1=-10.d0
  xprobmax1= 10.d0
  xprobmin2=-7.5d0
  xprobmax2= 7.5d0
  xprobmin3= 0.d0
  xprobmax3= 10.d0
/

&magnetic_topology_list
  mt_enable = .true.
  mt_mode = 'axis_plane_full_vtu'
  mt_vtk_detail = 'minimal'
  mt_output_file = 'output/benchmark/yz/u128_yz.vtu'
  mt_dL = 0.08d0
  mt_max_steps = 1600
  mt_b_min = 1.d-8
  mt_plane = 'yz'
  mt_ymin = -7.d0
  mt_ymax =  7.d0
  mt_ny = 128
  mt_zmin = 0.05d0
  mt_zmax = 9.5d0
  mt_nz = 128
  mt_x0 = 0.d0
/

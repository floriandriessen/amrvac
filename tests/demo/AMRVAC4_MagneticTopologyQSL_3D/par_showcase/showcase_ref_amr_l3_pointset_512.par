! Reference AMR l3 point-set example, 512 seeds.
&filelist
  convert=.true.
  convert_type='user'
  autoconvert=.false.
  restart_from_file='output/qsl_tdm_direct_amr_base128_l3_snap0000.dat'
/

&savelist
  itsave(1,1)=0
  itsave(1,2)=0
/

&stoplist
  it_max=0
  time_max=1.d0
/

&methodlist
  time_stepper='onestep'
  flux_scheme=20*'tvdlf'
  limiter=20*'minmod'
/

&boundlist
  typeboundary_min1=8*'cont'
  typeboundary_max1=8*'cont'
  typeboundary_min2=8*'cont'
  typeboundary_max2=8*'cont'
  typeboundary_min3=8*'cont'
  typeboundary_max3=8*'cont'
/

&paramlist
  courantpar=0.5d0
/

&mhd_list
  mhd_energy=.true.
  typedivbfix='none'
  B0field=.false.
/

&meshlist
  refine_max_level=3
  refine_criterion=1
  max_blocks=12000
  block_nx1=32
  block_nx2=32
  block_nx3=32
  domain_nx1=128
  domain_nx2=128
  domain_nx3=128
  xprobmin1=-10.d0
  xprobmax1= 10.d0
  xprobmin2=-7.5d0
  xprobmax2= 7.5d0
  xprobmin3= 0.d0
  xprobmax3= 10.d0
/

&magnetic_topology_list
  mt_enable = .true.
  mt_mode = 'seed_products'
  mt_seed_file = 'seed_points/ref_amr_l3_pointset_512.txt'
  mt_output_prefix = 'output/showcase/ref_amr_l3_pointset_512'
  mt_dL = 0.08d0
  mt_max_steps = 1600
  mt_b_min = 1.d-8
  mt_compute_twist = .true.
  mt_compute_qperp = .true.
/

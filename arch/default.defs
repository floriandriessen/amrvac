F90=mpif90
FFLAGS = -c
# -fallow-argument-mismatch: silence gfortran 10+ checks on MPI choice-buffer
# arguments (e.g. MPI_BCAST, MPI_FILE_WRITE) which dispatch on the MPI_<TYPE>
# handle at runtime. Not masking a code bug; matches OpenMPI/MPICH guidance.
F90FLAGS = -cpp -ffree-form -fimplicit-none -O3 -Wall -Wno-unused-dummy-argument	\
-Wno-unused-function -Wno-unused -Wno-uninitialized -Wno-zerotrip -Wno-target-lifetime \
-fallow-argument-mismatch
LINK= $(F90)  $(F90FLAGS)

! Snippet for the magnetic-topology namelist runner.
!
! This mode writes ParaView-readable VTU by default:
!
!   qsl_arb_arbitrary_plane_products.vtu
!
! Set mt_write_csv = .true. to also write the diagnostic CSV:
!
!   qsl_arb_arbitrary_plane_products.csv
!
! Products:
!   - length is always computed
!   - Tw is controlled by mt_compute_twist
!   - Qperp is controlled by mt_compute_qperp
!
! This mode does not compute axis-plane Q or mapping products.

&magnetic_topology_list
  mt_enable = .true.
  mt_mode = 'arbitrary_plane_products'
  mt_output_prefix = 'qsl_arb'

  mt_dL = 0.01d0
  mt_max_steps = 10000
  mt_b_min = 1.0d-12

  mt_compute_twist = .true.
  mt_compute_qperp = .true.
  mt_write_csv = .false.

  mt_origin = 0.0d0, 0.0d0, 0.0d0
  mt_e1 = 1.0d0, 0.0d0, 0.0d0
  mt_e2 = 0.0d0, 0.7071067811865475d0, 0.7071067811865475d0

  mt_s1min = -0.5d0
  mt_s1max =  0.5d0
  mt_n1 = 51

  mt_s2min = -0.5d0
  mt_s2max =  0.5d0
  mt_n2 = 51
/

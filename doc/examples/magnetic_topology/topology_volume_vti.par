! Snippet for &magnetic_topology_list.
! Add this block to an AMRVAC parameter file used by a mod_usr.t that calls
! mt_params_read(par_files) and mt_run_topology_task().
!
! Output:
!   volume_products.vti, appended-binary ImageData readable by ParaView.
!
! Data model:
!   This is a user-defined uniform Cartesian sampling volume. It is not
!   AMR-native AMRVAC volume output. Products are PointData attached to the
!   sampling seed points.
!
! Products:
!   Length is always computed. Tw and Qperp are optional. Qperp is more
!   expensive and memory-heavy than length/Tw.
!
! Memory:
!   mt_chunk_nz reduces temporary tracing memory by processing z slabs, but
!   the final VTI product arrays are still kept in memory before writing.
!
! Limitations:
!   No volume ordinary Q, no Qlocal, no AMR-native volume, and no
!   MPI/PVTU output in the current runner.
!
! Adjust bounds, resolution, dL, max_steps, b_min, and chunk_nz to your
! simulation.

&magnetic_topology_list
  mt_enable = .true.
  mt_mode = 'volume_vti'
  mt_output_file = 'volume_products.vti'

  mt_xmin = -0.5d0
  mt_xmax =  0.5d0
  mt_nx = 64

  mt_ymin = -0.5d0
  mt_ymax =  0.5d0
  mt_ny = 64

  mt_zmin = 0.0d0
  mt_zmax = 1.0d0
  mt_nz = 64

  mt_dL = 0.01d0
  mt_max_steps = 10000
  mt_b_min = 1.0d-12

  mt_compute_twist = .false.
  mt_compute_qperp = .true.
  mt_chunk_nz = 4
/


! Snippet for the magnetic-topology namelist runner.
!
! This mode reads arbitrary seed points from a simple whitespace text file:
!
!   topology_seed_products_seeds.txt
!
! Coordinates are in AMRVAC code units. The runner writes both outputs:
!
!   qsl_seed_demo_seed_products.csv
!   qsl_seed_demo_seed_products.vtu
!
! The CSV is useful for checking exact rows and status values. The VTU is a
! ParaView point cloud with one vertex cell per seed.
!
! Products:
!   - length is always computed
!   - Tw is controlled by mt_compute_twist
!   - Qperp is controlled by mt_compute_qperp
!
! This mode does not compute axis-plane Q or mapping products.

&magnetic_topology_list
  mt_enable = .true.
  mt_mode = 'seed_products'
  mt_seed_file = 'topology_seed_products_seeds.txt'
  mt_output_prefix = 'qsl_seed_demo'

  mt_dL = 0.01d0
  mt_max_steps = 10000

  mt_compute_twist = .true.
  mt_compute_qperp = .true.
/

! Snippet for &magnetic_topology_list.
! Add this block to an AMRVAC parameter file used by a mod_usr.t that calls
! mt_params_read(par_files) and mt_run_topology_task().
!
! Output:
!   qsl_xy_full.vtu, readable by ParaView.
!
! Products:
!   length, Tw, mapping metadata, Scott q0 Q, and Qperp.
!
! Interpretation:
!   Public Q is written as q/logQ or logQ depending on mt_vtk_detail.
!   Minimal output fields are length_total, twist_total, logQ, logQperp, and
!   connection_type_Q. Qperp fields use method2/qperp names in full-detail
!   output.
!   Qperp is independent and is not used to fill invalid Q values; there is no
!   mixed-source fallback, q_display field, or Q-specific visual alias field.
!
! Note:
!   mt_compute_twist and mt_compute_qperp are ignored in this mode because
!   axis_plane_full_vtu always computes length, Tw, Scott q0, and Qperp.
!   length_total comes from the Scott/Qperp tangent trace.
!   Adjust bounds, resolution, dL, max_steps, and b_min to your simulation.
!   For gfortran OpenMP conversion, build with ARCH=openmp and run one process
!   with OMP_NUM_THREADS=N. OpenMP currently accelerates minimal and full-detail
!   axis-plane seed tracing; VTU writing remains serial.

&magnetic_topology_list
  mt_enable = .true.
  mt_mode = 'axis_plane_full_vtu'
  mt_output_file = 'qsl_xy_full.vtu'
  mt_plane = 'xy'

  mt_xmin = -0.5d0
  mt_xmax =  0.5d0
  mt_nx = 101

  mt_ymin = -0.5d0
  mt_ymax =  0.5d0
  mt_ny = 101

  mt_z0 = 0.0d0

  mt_dL = 0.01d0
  mt_max_steps = 10000
  mt_b_min = 1.0d-12
/

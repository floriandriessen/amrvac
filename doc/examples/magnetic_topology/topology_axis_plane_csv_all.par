! Snippet for the magnetic-topology namelist runner.
!
! axis_plane_csv is an advanced table/debug workflow. For normal ParaView
! visualization of coordinate-plane QSL products, prefer axis_plane_full_vtu.
!
! Generated outputs:
!   qsl_axis_csv_all_xy_length.csv
!   qsl_axis_csv_all_xy_twist.csv
!   qsl_axis_csv_all_xy_mapping.csv
!   qsl_axis_csv_all_xy_qperp_method2.csv
!
! mt_compute_qperp enables endpoint-FDI Qperp. These products are separate:
! there is no fallback, comparison file, or q_display field.

&magnetic_topology_list
  mt_enable = .true.
  mt_mode = 'axis_plane_csv'
  mt_output_prefix = 'qsl_axis_csv_all'
  mt_plane = 'xy'

  mt_xmin = -0.5d0
  mt_xmax =  0.5d0
  mt_nx = 51

  mt_ymin = -0.5d0
  mt_ymax =  0.5d0
  mt_ny = 51

  mt_z0 = 0.0d0

  mt_dL = 0.01d0
  mt_max_steps = 10000
  mt_b_min = 1.0d-12

  mt_compute_twist = .true.
  mt_compute_qperp = .true.
/
